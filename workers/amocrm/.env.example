CORE_URL=http://localhost:8081
LOG_LEVEL=INFO

# Долгосрочный токен из карточки интеграции -> "Ключи и доступы".
# Обмен кода на токены не нужен: токен несёт срок годности внутри себя.
AMO_ACCESS_TOKEN=

# ВАЖНО: это api_domain из самого токена, а не поддомен аккаунта.
# amoCRM шардит аккаунты, и на неверном хосте получишь невнятный 401.
AMO_BASE_URL=https://api-b.amocrm.ru

# Воронка и этап. Пусто = первый этап основной воронки.
AMO_PIPELINE_ID=
AMO_STATUS_ID=
# Тег на каждой сделке — чтобы неудачный прогон можно было найти и удалить
# одним фильтром в CRM.
AMO_TAG=qorsa-leadgen

PUSH_BATCH=25
MAX_BATCHES_PER_RUN=10
REQUEST_DELAY_SECONDS=0.5
REQUEST_TIMEOUT_SECONDS=30

# Предохранитель: больше этого за один прогон не уйдёт.
MAX_LEADS_PER_RUN=100

DRY_RUN=false
RUN_ONCE=true
LOOP_INTERVAL_MINUTES=60
