# Скопируйте в .env (та же папка). Настоящий .env не коммитится
# (.gitignore: workers/**/.env). Ключей и паролей здесь нет и не будет:
# в hh вы входите руками в открытом окне (python -m workers.hh_apply.login).
#
# На Windows сохраняйте в UTF-8 без BOM (config.py BOM терпит, но всё же).

# Сайт hh. Корень страны — hh сам уведёт на региональный поддомен.
HH_HOST=hh.kz

# Подставляется в {my_name} в cover_letter.md.
MY_NAME=

# --- Темп: намеренно человеческий ---
# Пауза между откликами, секунды: диапазон, каждая пауза случайная из него.
# Меньше 10 с не принимается.
APPLY_DELAY_SECONDS=20-30
# Пауза между открытиями страниц при поиске и подготовке карточек.
BROWSE_DELAY_SECONDS=3-6

# Сколько откликов максимум за один прогон (потолок в коде — 50).
MAX_APPLIES_PER_RUN=20
# Сколько страниц вакансий прогон готов открыть, пока собирает карточки.
MAX_VACANCIES_TO_INSPECT=40
# Страниц выдачи на один запрос из keywords.yml.
SEARCH_PAGES=1

# Вторая ошибка подряд останавливает прогон.
STOP_AFTER_CONSECUTIVE_FAILURES=2

# Замедление каждого действия браузера, мс — чтобы вы успевали видеть, что происходит.
SLOW_MO_MS=250

LOG_LEVEL=INFO
