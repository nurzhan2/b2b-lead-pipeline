# Use a dedicated account, never your main one. A residential proxy is
# strongly recommended - datacenter IPs get challenged almost immediately.
IG_USERNAME=
IG_PASSWORD=
IG_PROXY=

CORE_URL=http://localhost:8081
SEND_TO_CORE=false
OUTPUT_CSV=workers/instagram_cta/instagram_leads.csv
LOG_LEVEL=INFO

# Pacing. Lower numbers are not faster in practice - they just get the
# account rate-limited sooner, and then the run stops.
MIN_DELAY_SECONDS=3
MAX_DELAY_SECONDS=7
MAX_REQUESTS_PER_RUN=400

# Keyword detection. Raise to 0.7 to accept only caption+comments agreement.
KEYWORD_MIN_CONFIDENCE=0.45
