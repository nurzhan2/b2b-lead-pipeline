CORE_URL=http://localhost:8081
LOG_LEVEL=INFO

# Ключ DaData: dadata.ru -> регистрация -> подтвердить почту ->
# личный кабинет -> раздел "Ключи" -> API-ключ.
# Бесплатный тариф: 10 000 запросов в день суммарно по всем видам подсказок.
# Без ключа воркер не стартует (и правильно: прогон без ключа пометил бы
# все компании как обработанные, ничего не найдя).
DADATA_API_KEY=

EGRUL_BATCH=50
MAX_BATCHES_PER_RUN=20
MAX_LOOKUPS_PER_RUN=2000
EGRUL_CONCURRENCY=3
REQUEST_DELAY_SECONDS=0.3
REQUEST_TIMEOUT_SECONDS=20

# Порог схожести названий. Ниже него кандидат отбрасывается: неверное ФИО
# директора в звонке хуже, чем его отсутствие.
MIN_NAME_SIMILARITY=0.82
ACTIVE_ONLY=true

RUN_ONCE=true
LOOP_INTERVAL_MINUTES=1440
